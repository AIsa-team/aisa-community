{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AIsa-team/aisa-community/schemas/project.schema.json",
  "title": "AIsa Community Project Submission",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "slug", "description", "author", "category", "repo_url", "submitted"],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 60,
      "description": "Display name of the project."
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,48}[a-z0-9]$",
      "description": "URL-safe identifier. Must match the folder name under projects/."
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 300,
      "description": "One or two sentences. What it does and why it's interesting."
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["github"],
      "properties": {
        "github": {
          "type": "string",
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9]|-(?=[A-Za-z0-9])){0,38}$",
          "description": "GitHub username (no @)."
        },
        "name": { "type": "string", "maxLength": 80 }
      }
    },
    "category": {
      "type": "string",
      "enum": [
        "productivity",
        "finance",
        "research",
        "developer-tools",
        "content",
        "automation",
        "data",
        "education",
        "entertainment",
        "other"
      ]
    },
    "tags": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,30}$" }
    },
    "repo_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://",
      "description": "Public repository of the project."
    },
    "demo_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://",
      "description": "Live demo, if any."
    },
    "video_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://",
      "description": "Demo video, if any."
    },
    "aisa_endpoints_used": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "maxLength": 60 },
      "description": "Which AIsa endpoints the project uses (e.g. stock/prices, search/web)."
    },
    "license": {
      "type": "string",
      "maxLength": 40,
      "description": "SPDX id of the project's own license (optional for projects)."
    },
    "competition": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}$",
      "description": "Set to a competition cycle (e.g. 2026-09) to enter that competition."
    },
    "submitted": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Submission date, YYYY-MM-DD."
    }
  }
}
