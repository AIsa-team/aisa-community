{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AIsa-team/aisa-community/schemas/winners.schema.json",
  "title": "AIsa Competition Winners",
  "description": "Ranked podium: up to three placed winners per cycle (1st, 2nd, 3rd). Place uniqueness is enforced by scripts/validate.mjs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["cycle", "theme", "winners"],
  "properties": {
    "cycle": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}$",
      "description": "Competition cycle, must match the folder name under competitions/."
    },
    "theme": { "type": "string", "maxLength": 120 },
    "announcement_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://",
      "description": "Link to the winners announcement (Discussion, blog post, X thread)."
    },
    "winners": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["place", "slug"],
        "properties": {
          "place": { "type": "integer", "minimum": 1, "maximum": 3 },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{1,48}[a-z0-9]$",
            "description": "Slug of the winning project (must exist in projects/)."
          },
          "note": { "type": "string", "maxLength": 200, "description": "Judges' one-line comment." }
        }
      }
    }
  }
}
